# MeFleet Backend Environment Variables (Example Template)
# Copy this file to .env and provide your actual API keys

# OpenRouteService API Key (for real-world road geometry and distance)
ORS_API_KEY=

# OpenWeatherMap API Key (for real-time weather and road condition warnings)
OPENWEATHER_API_KEY=

# SQLite Database Path / URL
DATABASE_URL=sqlite:///./mefleet.db

# Environment (development, staging, production)
ENVIRONMENT=development

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

